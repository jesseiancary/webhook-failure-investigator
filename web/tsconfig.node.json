{
  // Typechecks the node-land config files (vite / playwright) that live outside `src` and use node
  // built-ins — they're excluded from tsconfig.json ("include": ["src"], "types": ["vite/client"]).
  //
  // Referenced from the root tsconfig so it's part of the `tsc -b` graph AND so the editor's tsserver
  // discovers it (an unreferenced config is invisible to tsserver, which then falls back to the nearest
  // tsconfig.json — whose "types": ["vite/client"] can't resolve `node:process`, and the IDE error
  // returns). Being referenced means it must be composite (inherited from the base).
  //
  // src/lib/api-proxy.ts is listed because vite.config.ts imports it: a composite project may not pull
  // in a file it doesn't list (TS6307). We list the helper directly rather than referencing the app
  // project — referencing it would require that project to emit, which the root's `tsc -b --noEmit`
  // forbids (TS6310). The helper is pure TS, so it checks fine here under lib ES2022; `noEmit` means
  // this project never emits it, so co-listing it with the app project is safe.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "src/lib/api-proxy.ts"]
}
