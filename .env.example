# Copy to .env and adjust as needed: cp .env.example .env
# .env is git-ignored. These are local dev defaults — never commit real secrets.

# --- Postgres / docker-compose (used now) ---------------------------------
# Consumed by docker-compose.yml for the local Postgres container.
POSTGRES_USER=wfi
POSTGRES_PASSWORD=wfi_dev_password
POSTGRES_DB=wfi
POSTGRES_PORT=5432

# --- Application (wired in later phases) ----------------------------------
# DATABASE_URL — used by Prisma (Phase 3). Host-run app → localhost + POSTGRES_PORT.
DATABASE_URL=postgresql://wfi:wfi_dev_password@localhost:5432/wfi?schema=public

# OPENAI_API_KEY — used by the diagnosis service (Phase 4).
OPENAI_API_KEY=sk-your-key-here

# OPENAI_MODEL — diagnosis model (Phase 4). Defaults to gpt-4o-2024-08-06 when unset.
OPENAI_MODEL=gpt-4o-2024-08-06

# PORT — Express server port (read today in server/src/index.ts; defaults to 3000).
PORT=3000

# NODE_ENV — development | test | production.
NODE_ENV=development

# Note: the app does not yet load .env (Prisma/dotenv wiring lands in Phase 3).
# Today this file feeds `docker compose` variable substitution and documents the contract.
