# Copy to .env and adjust as needed: cp .env.example .env
# .env is git-ignored. These are local dev defaults — never commit real secrets.

# --- Postgres / docker-compose (used now) ---------------------------------
# Consumed by docker-compose.yml for the local Postgres container.
POSTGRES_USER=wfi
POSTGRES_PASSWORD=wfi_dev_password
POSTGRES_DB=wfi
POSTGRES_PORT=5432

# --- Application ----------------------------------------------------------
# DATABASE_URL — used by Prisma.
#   Host-run app (`pnpm dev`)      → host `localhost` + the port below. Values are loaded literally
#                                    (no `${VAR}` interpolation), so if you change POSTGRES_PORT above,
#                                    update the port in this line to match.
#   Full-stack container (compose) → host `postgres:5432`; docker-compose.yml sets that for the
#                                    server/web services, so you do NOT edit this line for Docker.
DATABASE_URL=postgresql://wfi:wfi_dev_password@localhost:5432/wfi?schema=public

# OPENAI_API_KEY — used by the diagnosis service (Phase 4).
OPENAI_API_KEY=sk-your-key-here

# OPENAI_MODEL — diagnosis model (Phase 4). Defaults to gpt-6-luna when unset.
OPENAI_MODEL=gpt-6-luna

# OPENAI_CHAT_MODEL — follow-up chat model (Phase 6). Defaults to gpt-6-luna when unset;
# point it at a cheaper/faster tier for the grounded Q&A endpoint without touching code.
OPENAI_CHAT_MODEL=gpt-6-luna

# OPENAI_REASONING_EFFORT — diagnosis reasoning effort on the Responses API (Phase 5). One of
# none, minimal, low, medium, high, xhigh, max; defaults to medium. Raise for the hardest cases.
# 'none' omits the reasoning parameter entirely — disables reasoning, and is required if OPENAI_MODEL
# points at a non-reasoning model (which rejects the field). An unknown value fails fast on the first
# diagnosis request (the value is read lazily, not at boot).
OPENAI_REASONING_EFFORT=medium

# WFI_FAKE_LLM — set to 1 to run with deterministic fake LLM clients (no OpenAI key, no network).
# Used by the Phase 7 Playwright e2e and for offline UI demos. Leave unset in normal host dev/prod.
# Note: the full-stack container (docker-compose.yml) DEFAULTS this to 1 so `docker compose up` runs
# offline with no key/spend; set WFI_FAKE_LLM=0 here (and a real OPENAI_API_KEY) for live diagnosis.
# WFI_FAKE_LLM=1

# PORT — Express server port (read today in server/src/index.ts; defaults to 3000).
PORT=3000

# NODE_ENV — development | test | production.
NODE_ENV=development

# --- Phase 10 deploy & hardening (production) -----------------------------
# These are unset for local host dev (each feature no-ops / omits itself when unset); you set them on
# the deployed service (see README "Deploying to Railway").

# ADMIN_API_TOKEN — shared bearer token guarding the one admin write, POST /capture-endpoints (minting
# public ingest URLs). Unset → that route is OPEN (fine for local dev; the server logs a one-time
# warning). In production set a random 32+ char secret; clients send `Authorization: Bearer <token>`.
# ADMIN_API_TOKEN=

# OPENAI_DAILY_COST_CAP_USD — global daily demo budget. When set, the paid endpoints
# (investigate/chat) refuse with a friendly 429 once today's summed cost (UTC) reaches it. Unset → no
# app-level daily cap (rely on the OpenAI-dashboard monthly budget). Must be a positive number.
# OPENAI_DAILY_COST_CAP_USD=2.00

# OPENAI_MAX_OUTPUT_TOKENS — per-request completion ceiling passed to the diagnosis + chat calls,
# bounding the most expensive dimension of a single call. Unset → the provider default applies.
# Positive integer.
# OPENAI_MAX_OUTPUT_TOKENS=1500

# WEB_DIST_PATH — optional override for where the built web bundle (web/dist) lives. The server serves
# it on one origin in production (express.static). Unset → resolved relative to the compiled server
# (../../web/dist, i.e. the runtime image's /app/web/dist). Setting it also force-enables static
# serving outside production — handy for a local prod-parity smoke.
# WEB_DIST_PATH=

# The server loads this file at startup via dotenv (server/src/config/env.ts); it also feeds
# `docker compose` variable substitution. Values already in process.env (shell/CI/compose
# `environment:`) take precedence over what's here.
